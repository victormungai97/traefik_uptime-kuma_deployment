# Restic repository settings for encrypted off-site backups to an S3-compatible storage service e.g. Backblaze B2.
# Copy this file to /etc/uptime-kuma-restic.env and replace every example value.
#
# RESTIC_REPOSITORY format:
#   s3:http(s)://S3_STORAGE_SERVICE_DOMAIN[:S3_STORAGE_SERVICE_PORT]/YOUR_BUCKET_NAME:optional/path/prefix
#
# Use an S3-compatible storage service's access key ID and secret access key restricted to the backup bucket.
# The key must allow listing, reading, writing, and deleting objects because
# restic forget --prune removes data no longer referenced by retained snapshots.

# S3-compatible storage service's API credentials
AWS_ACCESS_KEY_ID="<your_s3_access_key_id>"
AWS_SECRET_ACCESS_KEY="<your_s3_secret_access_key>"
# S3-compatible storage service's bucket's region, defaults to "us-east-1" if not specified
AWS_DEFAULT_REGION="<your_s3_bucket_region>"
# Restic Repository Configuration (S3 prefix)
RESTIC_REPOSITORY="s3:http(s)://<s3-storage-service-domain>[:<s3-storage-service-port>]/<your-private-bucket>:uptime-kuma"
RESTIC_PASSWORD="replace-with-a-long-unique-random-password"

# For Backblaze B2, it is recommended to use the B2 lifecycle “Keep only the last version of the file”. The previous version of the file is “hidden” for one day and then deleted automatically by B2.
# Learn more at https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html#s3-compatible-storage and https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html#backblaze-b2
